{
  "date": "2026-10-20",
  "title": "The Battle Before The Battle",
  "subtitle": "What The Leader Tolerates",
  "tagline": "What leadership repeatedly refuses to confront eventually receives permission to remain.",
  "series": "The Battle Before the Battle",
  "category": "Leadership & Culture",
  "seo_title": "What Leaders Tolerate Becomes Culture | TheWrkShop",
  "seo_description": "What leadership repeatedly refuses to confront eventually receives permission to remain. A biblical lesson on accountability for work, teams and home.",
  "keywords": [
    "leadership",
